# Database Configuration
DB_HOST=localhost          # Database host (e.g. localhost or 127.0.0.1)
DB_USER=admin              # Database username
DB_PASSWORD=your_password  # Database password
DB_NAME=your_database      # Name of the database used by the application

# Server Configuration
PORT=3000                  # Port on which the server will run

# Session Configuration
SESSION_SECRET=your_secret_key  # A long, random string used to sign session cookies